// Application resources for FastFile.
// User-selected source: Komfort-Zone-Unibody-Hds-Bootcamp.ico (embedded at all sizes).
// The icon below becomes FastFile.exe's shell icon (Explorer / taskbar / Alt-Tab);
// MainWnd.cpp also loads resource 1 at startup and pushes it to the window with
// WM_SETICON, because DuiLib registers its window class with wc.hIcon = NULL.
#include <windows.h>

1 ICON "FastFile.ico"

#include "FastFileBuildInfo.h"
2 RCDATA "../third_party/duilib/LICENSE"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION FASTFILE_VERSION_NUMBERS
 PRODUCTVERSION FASTFILE_VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "FastFile\0"
   VALUE "FileVersion", FASTFILE_VERSION_A "\0"
   VALUE "ProductName", "FastFile\0"
   VALUE "ProductVersion", FASTFILE_VERSION_A "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
